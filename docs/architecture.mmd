  CAL --> GCAL["Google Calendar"]
  FE -. "errors" .-> SEN["Sentry"]
  AI -. "errors" .-> SEN

  subgraph OFF["Offline, local"]
    direction LR
    CORP["carebridge-rag<br/>corpus, embeddings,<br/>search evaluation"]
