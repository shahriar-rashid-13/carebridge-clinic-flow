      EM["1. Emergency gate"] --> GR["2. Guardrails<br/>injection, PII,<br/>schema, confidence"] --> SUP["3. Supervisor<br/>route + up to 2 handoffs"] --> AG["4. Specialists<br/>triage, scheduling,<br/>billing, records"]
