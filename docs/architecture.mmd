flowchart TB
  U["Patient, doctor, receptionist"] --> FE["React app on Vercel<br/>/ai chat, /campaigns, /metrics"]

  FE -- "sign-in, data (JWT + RLS)" --> DB
  FE -- "chat message" --> AI

  subgraph SB["Supabase"]
    direction TB
